APP_ENV=production
LOG_LEVEL=INFO

# Required for Qwen-powered research tasks. Set this in the cloud platform secret store.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
QWEN_WORKSPACE_ID=
QWEN_TIMEOUT_SECONDS=120

# Optional source credentials
GDC_AUTH_TOKEN=
CIVIC_API_KEY=

# Keep deterministic local vector search unless RAG extras are explicitly installed.
RAG_VECTOR_BACKEND=memory
RAG_EMBEDDING_BACKEND=hashing
